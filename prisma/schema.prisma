// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CustomerSegment {
  id            String   @id @default(cuid())
  shop          String
  name          String
  orderRule     String   @default("any")
  tag           String   @default("")
  spendRule     String   @default("any")
  spendAmount   Float?
  lastOrderDays Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

model ApprovedWhatsAppTemplate {
  id             String   @id @default(cuid())
  shop           String
  metaTemplateId String
  name           String
  language       String
  category       String
  components     String
  syncedAt       DateTime @default(now())

  @@unique([shop, metaTemplateId])
  @@index([shop, name])
}

model CampaignDraft {
  id         String   @id @default(cuid())
  shop       String
  name       String
  templateId String
  segmentId  String
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, updatedAt])
}

model ShopifyCustomerMirror {
  id String @id
  shop String
  firstName String?
  lastName String?
  email String?
  phone String?
  numberOfOrders Int @default(0)
  amountSpent Float @default(0)
  currencyCode String @default("INR")
  tagsJson String @default("[]")
  whatsappOptIn Boolean @default(false)
  createdAtShopify DateTime?
  updatedAtShopify DateTime?
  syncedAt DateTime @default(now())
  orders ShopifyOrderMirror[]
  @@unique([shop, id])
  @@index([shop, numberOfOrders])
  @@index([shop, email])
  @@index([shop, phone])
  @@index([shop, lastName, firstName])
}
model ShopifyOrderMirror {
  id String @id
  shop String
  customerId String
  orderName String
  orderNumber Int?
  processedAt DateTime?
  createdAtShopify DateTime?
  totalPrice Float @default(0)
  currencyCode String @default("INR")
  financialStatus String?
  fulfillmentStatus String?
  lineItemsJson String @default("[]")
  syncedAt DateTime @default(now())
  customer ShopifyCustomerMirror @relation(fields: [shop, customerId], references: [shop, id], onDelete: Cascade)
  @@unique([shop, id])
  @@index([shop, customerId, processedAt])
  @@index([shop, orderName])
}
model WhatsAppCampaign {
  id String @id @default(cuid())
  shop String
  name String
  templateId String
  templateName String
  templateLanguage String
  templateComponents String
  variableMappingJson String @default("{}")
  mediaUrl String?
  scheduledAt DateTime?
  status String @default("DRAFT")
  audienceCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients WhatsAppCampaignRecipient[]
  @@index([shop, status, scheduledAt])
  @@index([shop, createdAt])
}
model WhatsAppCampaignRecipient {
  id String @id @default(cuid())
  campaignId String
  shop String
  customerId String?
  phoneNumber String
  customerName String?
  snapshotJson String @default("{}")
  status String @default("QUEUED")
  whatsappMessageId String?
  error String?
  attempts Int @default(0)
  queuedAt DateTime @default(now())
  sentAt DateTime?
  deliveredAt DateTime?
  readAt DateTime?
  failedAt DateTime?
  updatedAt DateTime @updatedAt
  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([campaignId, phoneNumber])
  @@index([shop, status, queuedAt])
  @@index([shop, whatsappMessageId])
}
model WhatsAppConversation {
  id            String            @id @default(cuid())
  shop          String
  phoneNumber   String
  customerName  String?
  lastMessageAt DateTime          @default(now())
  lastInboundAt DateTime?
  unreadCount   Int               @default(0)
  isDemo        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      WhatsAppMessage[]

  @@unique([shop, phoneNumber])
  @@index([shop, lastMessageAt])
}

model WhatsAppMessage {
  id                String               @id @default(cuid())
  conversationId    String
  shop              String
  direction         String
  type              String
  text              String
  status            String
  whatsappMessageId String?
  clientRequestId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([shop, whatsappMessageId])
  @@unique([shop, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([shop, createdAt])
}

model WhatsAppMessageStatusEvent {
  id                String   @id @default(cuid())
  shop              String
  whatsappMessageId String
  status            String
  eventAt           DateTime
  receivedAt        DateTime @default(now())

  @@unique([shop, whatsappMessageId, status])
  @@index([shop, whatsappMessageId])
}

model WhatsAppWebhookVerification {
  shop          String   @id
  phoneNumberId String
  verifiedAt    DateTime @default(now())
}
